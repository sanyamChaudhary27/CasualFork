{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "share": "manual",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": {
      "*": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "python scripts/verify_company.py*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
