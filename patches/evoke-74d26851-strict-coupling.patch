+def _require_key(gs, key):
+    """geo_state-keyed mappings are LOUD: an absent key raises AttributeError
+    so the digest records an honest MISSING (never a silent fake value);
+    present-but-None stays a legitimate digestable value (early-chunk state)."""
+    if isinstance(gs, dict) and key not in gs:
+        raise AttributeError(key)
+    return gs.get(key)
