+def derive_strict_cpu_seed(base_seed, fork_chunk, pair_identity,
+                           pin=PATCH_TARGET_PIN):
+    """Documented derivation (condition B): sha256 over run-identity inputs
+    WITHOUT branch identity; 64-bit slice (first 16 hex chars) of the digest."""
+    payload = ("causalfork/sc1-strict-cpu-rng@1|pin=%s|base_seed=%s|"
+               "fork_chunk=%s|pair_id=%s" % (pin, base_seed, fork_chunk,
+                                             pair_identity))
+    return int(hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16], 16)
