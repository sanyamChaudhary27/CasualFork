+def ensure_strict_cpu_rng(cfg, chunk_index):
+    """Initialize the DEFAULT CPU generator deterministically ONCE per process
+    at the FIRST fork-hook invocation (== rollout start under the frozen
+    profile; see module docstring). CPU-only: touches torch.set_rng_state and
+    nothing else - no CUDA RNG, no managed Generator."""
+    global _STRICT_CPU_RNG
+    if _STRICT_CPU_RNG is not None:
+        return _STRICT_CPU_RNG
+    base_seed = os.environ.get(ENV_BASE_SEED, "UNSET")
+    fc = _safe_meta_int(cfg)
+    seed64 = derive_strict_cpu_seed(base_seed, fc, pair_id())
+    cpu_gen = torch.Generator(device="cpu")
+    cpu_gen.manual_seed(seed64)
+    torch.set_rng_state(cpu_gen.get_state())
+    # Hash the default-CPU state DIRECTLY (not via global_rng_digest, whose
+    # active() gate depends on unrelated ledger env vars).
+    _post = hashlib.sha256(torch.get_rng_state().contiguous().reshape(
+        -1).numpy().tobytes()).hexdigest()
+    _STRICT_CPU_RNG = {
+        "policy": STRICT_CPU_RNG_POLICY,
+        "seed": seed64,
+        "cpu_rng_sha256_after_init": _post,
+        "cpu_rng_sha256_at_fork": None,       # filled at the boundary itself
+        "initialized_at_chunk": int(chunk_index),
+        "base_seed_declared": base_seed != "UNSET",
+    }
+    print("[StrictFork] default CPU RNG deterministically initialized "
+          "(policy=sc1-strict-cpu-rng@1 seed=%d chunk=%s)"
+          % (seed64, chunk_index), flush=True)
+    return _STRICT_CPU_RNG
