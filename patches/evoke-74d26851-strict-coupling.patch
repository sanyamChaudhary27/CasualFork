diff --git a/evoke/strict_fork.py b/evoke/strict_fork.py
new file mode 100644
index 0000000..4202fd6
--- /dev/null
+++ b/evoke/strict_fork.py
@@ -0,0 +1,1406 @@
+"""CausalFork SC1 strict-coupling instrumentation V2 (+ FINAL CPU ROUND adapter).
+
+ADDED BY PATCH evoke-74d26851-strict-coupling (STAGE-B/C fix round + FINAL CPU
+ROUND 2026-08-26) on top of AlayaLab/Evoke @ 74d268516d95c8fceadd2378f91a73f9f187042b.
+Everything here is env-gated: when no gate env var is set, instrumented call
+sites reduce to cheap early-returns and upstream behaviour (including RNG
+streams) is unchanged.
+
+Gates
+-----
+EVOKE_STRICT_LEDGER_PATH    base ledger path; the emitter opens a UNIQUE NEW
+                            FILE PER RUN "<stem>.<run_id>.jsonl" in exclusive-
+                            creation mode. Appending to an existing ledger is a
+                            hard error (no silent append mixing, ever).
+EVOKE_STRICT_RUN_ID         run identity; every meta/draw/event line carries it
+                            plus EVOKE_STRICT_PAIR_ID (auto uuid when unset).
+EVOKE_STRICT_BRANCH_ID      branch label for the ledger (default "factual").
+EVOKE_WARP_SEED             PRECOND-1 (da3_cloud covis generator seed);
+                            presence/sha256 recorded in ledgers and sidecars.
+EVOKE_STRICT_FORK_JSON      fork-boundary hook config; inline JSON or path:
+                              {"fork_chunk": C, "mode": "capture", "out_dir": D}
+                              {"fork_chunk": C, "mode": "restore",
+                               "sidecar": JSON, "parent_state_digest": JSON}
+                            The hook runs at the TOP of each chunk loop iteration
+                            (pipeline_evoke.py, `for k in _chunk_iter`), i.e.
+                            BEFORE prompt selection, warp render and ANY
+                            post-fork stochastic draw. The hook receives an
+                            EPHEMERAL NON-OWNING LiveStateView built from the
+                            __call__ locals/geo_state AT THE TRUE CHUNK BOUNDARY
+                            (see build_live_state_view) - never the raw
+                            pipeline. Construction itself is gated to
+                            StrictCoupling-active (_sf_fork_active()).
+                            capture: generator snapshot (.pt + sha256 sidecar)
+                            PLUS FORK_STATE_DIGEST v1 (canonical F01-F14,
+                            harness/fork_state_digest.py spec) written NEXT TO
+                            the capture as fork_state_digest_chunk<C>.json.
+                            restore: replayed branch re-captures its boundary
+                            state and compares BEFORE any chunk-C draw; any
+                            REQUIRED-field mismatch aborts the run loudly
+                            (FORK_STATE_MISMATCH ledger line + RuntimeError).
+EVOKE_STRICT_PATCH_SHA256 / EVOKE_STRICT_PROFILE_SHA256 /
+EVOKE_STRICT_CONFIG_SHA256  launch-time identity declarations exported by the
+                            launcher (see profiles/sc1_launcher_binding.md);
+                            literal "UNDECLARED" is ILLEGAL in launch-strict
+                            validation -> INVALID(IDENTITY_UNDECLARED).
+EVOKE_GPU01_PRELAUNCH_ARTIFACT mandatory strict-launch archive written by the
+                             GPU-01 wrapper. The engine recomputes the canonical
+                             resolved config and rejects any mismatch before
+                             model construction; operator-provided config hashes
+                             are never an authority.
+EVOKE_STRICT_BASE_SEED      launcher-exported resolved --seed; input to the
+                            strict CPU RNG derivation (condition B).
+EVOKE_TEST_MODE_ONLY        local-CPU-only marker: when diffusers is absent AND
+                            this is "1", meta.diffusers records the explicit
+                            marker TEST_MODE_ONLY instead of UNDECLARED. Such
+                            ledgers can NEVER receive a GPU countersignature
+                            (validator refuse_gpu_countersign hard-refuses).
+
+Site emission contract (adjudication 2026-08-25):
+  R2/R3  extra carries sha256_input_pixels / sha256_mean / sha256_std
+         diagnostics (byte-equality witnesses at the fork chunk).
+  R7     one row per source gid per render call: render_call id, call_ordinal,
+         high=wp.shape[0], skip_flag; empty-domain gids emit skip rows; index
+         tensors are witness-only and never compared post-divergence by the
+         validator.
+
+F10 DEFAULT CPU RNG POLICY (condition B)
+----------------------------------------
+Upstream never seeds the DEFAULT CPU generator; separate OS processes diverge.
+Under StrictCoupling ONLY (fork_cfg active), the FIRST fork-hook invocation -
+which under the frozen profile IS the rollout start, because the hook fires at
+the TOP of chunk iteration 0 before prompt selection/warp render/ANY R-site
+draw and every audited stochastic site uses an explicit generator (7 sites,
+profiles/sc1_strict_profile.json; short-tier/sigma-lock/anti-drift/patchdrop/
+DMD consumers are all forced off) - deterministically initializes the DEFAULT
+CPU generator:
+
+    strict_cpu_rng_seed =
+        int( sha256( "causalfork/sc1-strict-cpu-rng@1|pin=<pin>|base_seed=<bs>|"
+                     "fork_chunk=<c>|pair_id=<pid>" ).hexdigest()[:16], 16 )
+
+    cpu_gen = torch.Generator(device="cpu"); cpu_gen.manual_seed(seed)
+    torch.set_rng_state(cpu_gen.get_state())   # CPU default RNG ONLY
+
+base_seed comes from EVOKE_STRICT_BASE_SEED (launcher exports the resolved
+--seed); the literal fallback "UNSET" keeps two processes equal iff both unset
+(any asymmetry surfaces as META_MISMATCH:strict_cpu_rng_seed). The derivation
+excludes branch identity so factual and CF replay processes initialize
+identically. CUDA global RNG and managed Generators are NEVER touched (no
+torch.cuda.*, no torch.manual_seed, no Generator.set_state on main streams);
+test RNG3 proves the main generator bytes are unchanged.
+
+NoiseTape.record backs the ledger; NoiseTape.replay remains a PHASE-2 FALLBACK
+stub (raises NotImplementedError).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import threading
+
+import torch
+
+try:  # Applied EVOKE tree; the fallback keeps source-level CPU tests standalone.
+    from . import gpu01_config_identity as _gpu01_identity
+    from . import gpu01_fork_protocol as _gpu01_fork_protocol
+except ImportError:  # pragma: no cover - exercised by harness source loader
+    import gpu01_config_identity as _gpu01_identity
+    import gpu01_fork_protocol as _gpu01_fork_protocol
+
+PATCH_TARGET_PIN = "74d268516d95c8fceadd2378f91a73f9f187042b"
+PATCH_ID = "evoke-74d26851-strict-coupling"
+
+ENV_LEDGER = "EVOKE_STRICT_LEDGER_PATH"
+ENV_BRANCH = "EVOKE_STRICT_BRANCH_ID"
+ENV_FORK = "EVOKE_STRICT_FORK_JSON"
+ENV_WARP_SEED = "EVOKE_WARP_SEED"
+ENV_RUN_ID = "EVOKE_STRICT_RUN_ID"
+ENV_PAIR_ID = "EVOKE_STRICT_PAIR_ID"
+ENV_PATCH_SHA = "EVOKE_STRICT_PATCH_SHA256"
+ENV_PROFILE_SHA = "EVOKE_STRICT_PROFILE_SHA256"
