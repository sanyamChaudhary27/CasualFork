+def _patch_meta_f10_evidence():
+    """Rewrite an already-open ledger header with the boundary F10 evidence.
+
+    The header can be emitted by chunk zero before the configured fork chunk,
+    so its initial at-fork field is necessarily null. Once the true boundary
+    is reached, update it before emitting the capture/restore event.
+    """
+    if _LEDGER_FH is None or not getattr(_LEDGER_FH, "name", None):
+        return
+    path = _LEDGER_OPENED or _LEDGER_FH.name
+    rec = strict_cpu_rng_record() or {}
+    try:
+        _LEDGER_FH.flush()
+        with open(path, "r", encoding="utf-8") as fh:
+            lines = fh.readlines()
+        if not lines:
+            raise RuntimeError("ledger has no meta header")
+        head = json.loads(lines[0])
+        if head.get("event") != "meta":
+            raise RuntimeError("ledger first line is not meta")
+        head.update({
+            "strict_cpu_rng_policy": STRICT_CPU_RNG_POLICY,
+            "strict_cpu_rng_seed": rec.get("seed"),
+            "cpu_rng_sha256_after_init": rec.get("cpu_rng_sha256_after_init"),
+            "cpu_rng_sha256_at_fork": rec.get("cpu_rng_sha256_at_fork"),
+        })
+        lines[0] = json.dumps(head, sort_keys=True) + "\n"
+        _LEDGER_FH.close()
+        with open(path, "w", encoding="utf-8", newline="\n") as fh:
+            fh.writelines(lines)
+        globals()["_LEDGER_FH"] = open(path, "a", encoding="utf-8", newline="\n")
+    except (ValueError, OSError, RuntimeError) as exc:
+        raise RuntimeError(
+            "[StrictFork] F10_META_EVIDENCE_UNVERIFIED: cannot update strict "
+            "CPU-RNG boundary evidence (%r)" % (exc,))
+
+
+def _patch_meta_continuation():
+    """Lazy-meta repair: the meta header is written at first ledger use,
+    before restore status is knowable. Once a restore succeeds, rewrite the
+    header's continuation field so validator META checks reflect reality.
+
+    SINGLE-WRITER TRUNCATE-ON-CRASH WINDOW (documented): this rewrite truncates
+    the ledger file (open(path, "w")) and rewrites every buffered line from
+    memory in ONE writelines call. A process crash BETWEEN truncation and
+    completion loses all lines after the header. Accepted because the
+    unique-ledger-per-run policy makes this process the ONLY writer (no
+    interleaving possible); the window is bounded by one writelines call.
+
+    The silent except-pass of the previous revision is REMOVED: on ANY failure
+    the module flag _META_CONTINUATION_VERIFIED goes False, a structured
+    {"event": "META_PATCH_FAILURE", ...} ledger line is emitted (best effort,
+    lock-free append), and RuntimeError re-raises so STRICT CERTIFICATION
+    ABORTS loudly. The validator turns that marker into INVALID
+    (META_CONTINUATION_UNVERIFIED)."""
+    global _META_CONTINUATION_VERIFIED
+    if _LEDGER_FH is None or not getattr(_LEDGER_FH, "name", None):
+        return
+    path = _LEDGER_OPENED or _LEDGER_FH.name
+    _LEDGER_FH.flush()
+    try:
+        with open(path, "r", encoding="utf-8") as fh:
+            lines = fh.readlines()
+        if not lines:
+            return
+        head = json.loads(lines[0])
+        if head.get("event") != "meta":
+            return
+        if head.get("continuation") == CONTINUATION_MARKER:
+            _META_CONTINUATION_VERIFIED = True
+            return
+        head["continuation"] = CONTINUATION_MARKER
+        lines[0] = json.dumps(head, sort_keys=True) + "\n"
+        _LEDGER_FH.close()
+        with open(path, "w", encoding="utf-8", newline="\n") as fh:
+            fh.writelines(lines)
+        globals()["_LEDGER_FH"] = open(path, "a", encoding="utf-8", newline="\n")
+        _META_CONTINUATION_VERIFIED = True
+    except (ValueError, OSError, RuntimeError) as exc:
+        _META_CONTINUATION_VERIFIED = False
+        try:
+            with open(path, "a", encoding="utf-8", newline="\n") as fh:
+                fh.write(json.dumps({
+                    "event": META_PATCH_FAILURE_EVENT,
+                    "error": "%s: %s" % (type(exc).__name__, exc),
+                    "path": path,
+                    "run_id": run_id(), "pair_id": pair_id(),
+                    "branch_id": get_branch_id(),
+                }, sort_keys=True) + "\n")
+        except Exception:
+            pass   # even the marker could not be written; the raised error
+                   # below still aborts - certification cannot proceed on an
+                   # unverifiable ledger.
+        raise RuntimeError(
+            "[StrictFork] meta continuation rewrite FAILED (%r); strict "
+            "certification aborts (META_CONTINUATION_UNVERIFIED)" % (exc,))
+
+
+def continuation_verified():
+    """Expose the lazy-meta rewrite status for in-process assertions."""
+    return _META_CONTINUATION_VERIFIED
+
+
+def maybe_fork_boundary(chunk_index, generators, pipeline=None):
+    """TRUE fork boundary hook: called at the TOP of every chunk iteration;
+    acts only at cfg.fork_chunk, before prompt selection / warp render / ANY
+    post-fork stochastic draw. `pipeline` is the ephemeral LiveStateView built
+    by the patched hunk (observational-only), never the raw pipeline."""
+    cfg = fork_cfg()
+    if cfg is None:
+        return None
+    # Condition B: FIRST hook invocation == deterministic CPU-RNG rollout
+    # start (before any draw; equivalence argument in the module docstring).
+    ensure_strict_cpu_rng(cfg, chunk_index)
+    if int(cfg.get("fork_chunk", -(10 ** 9))) != int(chunk_index):
+        return None
+    mode = str(cfg.get("mode", "capture")).lower()
+    if mode == "capture":
+        return _fork_capture(cfg, int(chunk_index), generators, pipeline)
+    if mode == "restore":
+        return _fork_restore(cfg, int(chunk_index), generators, pipeline)
+    raise ValueError("[StrictFork] unknown mode: %r" % (mode,))
+
+
+def _fork_capture(cfg, chunk_index, generators, pipeline=None):
+    out_dir = cfg.get("out_dir")
+    if not out_dir:
+        raise ValueError("[StrictFork] capture mode requires out_dir")
+    if pipeline is None:
+        raise ValueError("[StrictFork] capture mode requires the pipeline "
+                         "object (FORK_STATE_DIGEST is REQUIRED)")
+    if not isinstance(pipeline, LiveStateView):
+        raise ValueError(
+            "[StrictFork] capture requires the EPHEMERAL LiveStateView built "
+            "by build_live_state_view at the true chunk boundary (got %s); "
+            "raw pipelines are rejected so the digest provably reads boundary "
+            "state, not stale attributes." % type(pipeline).__name__)
+    if _STRICT_CPU_RNG is not None and _STRICT_CPU_RNG.get(
+            "cpu_rng_sha256_at_fork") is None:
+        _STRICT_CPU_RNG["cpu_rng_sha256_at_fork"] = global_rng_digest()
+    # Build and validate the digest BEFORE creating any capture artifact. This
+    # makes F12/F13/F10 failures terminal rather than leaving partial sidecars.
+    digest = capture_fork_state_digest(pipeline, generators,
+                                       fork_chunk=chunk_index,
+                                       branch_id=get_branch_id())
+    _f10_why = _f10_evidence_reason(
+        ((digest.get("fields") or {}).get("F10") or {})
+        .get("global_cpu_rng_sha256"))
+    if _f10_why:
+        raise RuntimeError(
+            "[StrictFork] %s: FORK_STATE_DIGEST refused at chunk %d - strict "
+            "CPU-RNG policy evidence (strict_cpu_rng_seed, "
+            "cpu_rng_sha256_after_init, cpu_rng_sha256_at_fork) must exist and "
+            "equal the boundary F10 global_cpu_rng_sha256." % (_f10_why,
+                                                               chunk_index))
+    _patch_meta_f10_evidence()
+    if digest.get("missing_required_paths"):
+        raise RuntimeError(
+            "[StrictFork] FORK_STATE_DIGEST missing REQUIRED fields: %s"
+            % (sorted(set(digest["missing_required_paths"])),))
+    os.makedirs(out_dir, exist_ok=True)
+    gens_json = {}
+    for name in sorted(generators):
+        g = generators[name]
+        st = g.get_state().cpu().contiguous()
+        raw = st.reshape(-1).numpy().tobytes()
+        gen_digest = sha256_bytes(raw)
+        pt_path = os.path.join(out_dir, "genstate_%s_chunk%d.pt"
+                               % (name, chunk_index))
+        torch.save({"name": name, "chunk": chunk_index,
+                    "pin": PATCH_TARGET_PIN, "state": st}, pt_path)
+        gens_json[name] = {"path": pt_path, "sha256": gen_digest, "nbytes": len(raw)}
+    sidecar = {
+        "kind": "EVOKE_STRICT_FORK_CAPTURE",
+        "pin": PATCH_TARGET_PIN,
+        "patch": PATCH_ID,
+        "branch_id": get_branch_id(),
+        "fork_chunk": chunk_index,
+        "generators": gens_json,
+        "warp_seed": _warp_seed_record(),
+        "global_rng_sha256": global_rng_digest(),
+        "strict_cpu_rng": strict_cpu_rng_record(),
+        "state_view": {"kind": "LiveStateView", "observational_only": True},
+        "torch": torch.__version__,
+        "created_utc": _utcnow(),
+    }
+    sc_path = os.path.join(out_dir, "fork_capture_chunk%d.json" % chunk_index)
+    with open(sc_path, "w", encoding="utf-8", newline="\n") as fh:
+        json.dump(sidecar, fh, indent=2, sort_keys=True)
+    # FORK_STATE_DIGEST sidecar next to the generator capture (REQUIRED).
+    dg_path = os.path.join(out_dir, "fork_state_digest_chunk%d.json"
+                           % chunk_index)
+    with open(dg_path, "w", encoding="utf-8", newline="\n") as fh:
+        fh.write(json.dumps(digest, sort_keys=True,
+                            separators=(",", ":")) + "\n")
+    print("[StrictFork] FORK_CAPTURE branch=%s chunk=%d gens=%s -> %s "
+          "(state digest: %s)"
+          % (get_branch_id(), chunk_index, sorted(gens_json), sc_path, dg_path),
+          flush=True)
+    _write_event({
+        "event": "FORK_CAPTURE", "branch_id": get_branch_id(),
+        "chunk": chunk_index, "generators": sorted(gens_json),
+        "sidecar": sc_path, "state_digest": dg_path,
+    })
+    return sc_path
+
+
+def _fork_restore(cfg, chunk_index, generators, pipeline=None):
+    side = cfg.get("sidecar")
+    if not side:
+        raise ValueError("[StrictFork] restore mode requires sidecar")
+    if pipeline is None:
+        raise ValueError("[StrictFork] restore mode requires the pipeline "
+                         "object (FORK_STATE_DIGEST comparison is REQUIRED)")
+    if not isinstance(pipeline, LiveStateView):
+        raise ValueError(
+            "[StrictFork] restore requires the EPHEMERAL LiveStateView built "
+            "by build_live_state_view at the true chunk boundary (got %s)."
+            % type(pipeline).__name__)
+    with open(side, "r", encoding="utf-8") as fh:
+        meta = json.load(fh)
+    if meta.get("kind") != "EVOKE_STRICT_FORK_CAPTURE":
+        raise RuntimeError("[StrictFork] sidecar kind mismatch: %r"
+                           % (meta.get("kind"),))
+    if meta.get("pin") != PATCH_TARGET_PIN:
+        raise RuntimeError("[StrictFork] sidecar pin %r != patched pin"
+                           % (meta.get("pin"),))
+    if int(meta.get("fork_chunk", -1)) != chunk_index:
+        raise RuntimeError("[StrictFork] sidecar fork_chunk %r != boundary %d"
+                           % (meta.get("fork_chunk"), chunk_index))
+    restored = []
+    for name in sorted(meta.get("generators", {})):
+        info = meta["generators"][name]
+        g = generators.get(name)
+        if g is None:
+            raise RuntimeError("[StrictFork] restore: generator %r absent at "
+                               "boundary" % (name,))
+        obj = torch.load(info["path"], map_location="cpu", weights_only=True)
+        st = obj["state"]
+        raw = st.contiguous().reshape(-1).numpy().tobytes()
+        if sha256_bytes(raw) != info["sha256"]:
+            raise RuntimeError("[StrictFork] captured state hash mismatch for %r"
+                               % (name,))
+        g.set_state(st.to(torch.uint8))
+        restored.append(name)
+    # ---- FORK_STATE_DIGEST: compare BEFORE any chunk-c* draw -----------------
+    parent_path = cfg.get("parent_state_digest")
+    if not parent_path:
+        raise ValueError("[StrictFork] restore mode requires "
+                         "parent_state_digest (boundary-state equivalence is "
+                         "REQUIRED under STRICT_NOISE_COUPLED)")
+    with open(parent_path, "r", encoding="utf-8") as fh:
+        parent_digest = json.load(fh)
+    out_dir = os.path.dirname(os.path.abspath(side)) or "."
+    if _STRICT_CPU_RNG is not None and _STRICT_CPU_RNG.get(
+            "cpu_rng_sha256_at_fork") is None:
+        _STRICT_CPU_RNG["cpu_rng_sha256_at_fork"] = global_rng_digest()
+    child_digest = capture_fork_state_digest(pipeline, generators,
+                                             fork_chunk=chunk_index,
+                                             branch_id=get_branch_id())
+    _f10_why = _f10_evidence_reason(
+        ((child_digest.get("fields") or {}).get("F10") or {})
+        .get("global_cpu_rng_sha256"))
+    if _f10_why:
+        raise RuntimeError(
+            "[StrictFork] %s: restored branch cannot certify its boundary "
+            "state digest without matching strict CPU-RNG evidence."
+            % (_f10_why,))
+    _patch_meta_f10_evidence()
+    child_path = os.path.join(out_dir, "fork_state_digest_child_chunk%d.json"
+                              % chunk_index)
+    with open(child_path, "w", encoding="utf-8", newline="\n") as fh:
+        fh.write(json.dumps(child_digest, sort_keys=True,
+                            separators=(",", ":")) + "\n")
+    report = compare_fork_state_digest(parent_digest, child_digest)
+    if not report["match"]:
+        detail = {"mismatches": report["mismatches"], "missing": report["missing"]}
+        _write_event({
+            "event": "FORK_STATE_MISMATCH", "branch_id": get_branch_id(),
+            "chunk": chunk_index, "detail": detail,
+            "child_state_digest": child_path, "parent_state_digest": parent_path,
+        })
+        raise RuntimeError("[StrictFork] FORK_STATE_MISMATCH at chunk %d: %s"
+                           % (chunk_index, json.dumps(detail, sort_keys=True)))
+    global _RESTORED
+    with _LOCK:
+        _RESTORED = CONTINUATION_MARKER
+        _patch_meta_continuation()
+        rec = {
+            "event": CONTINUATION_MARKER,
+            "branch_id": get_branch_id(),
+            "chunk": chunk_index,
+            "restored_generators": restored,
+            "sidecar": side,
+            "state_digest_parent": parent_path,
+            "state_digest_child": child_path,
+        }
+    _write_event(rec)
+    print("[StrictFork] GENERATOR_STATE_RESTORED branch=%s chunk=%d gens=%s "
+          "(state digest MATCH)" % (get_branch_id(), chunk_index, restored),
+          flush=True)
+    return rec
+
+
+def continuation_marker():
+    return _RESTORED
+
+
+def _utcnow():
+    import datetime
+    return datetime.datetime.utcnow().replace(microsecond=0).isoformat() + "Z"
+
+
+def reset_for_tests():
+    """Isolate module state between unit tests (not used on the engine path)."""
+    global _FORK_CFG, _FORK_CFG_RAW, _LEDGER_FH, _META_WRITTEN, _RESTORED, \
+        _LEDGER_OPENED, _SEQ, _STRICT_CPU_RNG, _META_CONTINUATION_VERIFIED, \
+        _ENGINE_ATTESTATION
+    with _LOCK:
+        _ORDINALS.clear()
+        _SEQ["n"] = 0
+        _CTX.update({"branch_id": None, "chunk": None, "stage": None})
+        _FORK_CFG = None
+        _FORK_CFG_RAW = None
+        if _LEDGER_FH is not None:
+            try:
+                _LEDGER_FH.close()
+            except Exception:
+                pass
+        _LEDGER_FH = None
+        _LEDGER_OPENED = None
+        _META_WRITTEN = False
+        _RESTORED = None
+        _TAPE.entries.clear()
+        _RENDER_CALL["n"] = 0
+        _RUN_CACHE.clear()
+        _STRICT_CPU_RNG = None
+        _META_CONTINUATION_VERIFIED = None
+        _ENGINE_ATTESTATION = None
