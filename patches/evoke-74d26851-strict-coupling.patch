+def _estimator_stream_digest(est):
+    """F09 ADVISORY digest over the estimator NON-kv stream state.
+
+    Audited live sources: ViGeoDepthEstimator._scale_locked
+    (vigeo_cloud.py:340), ._anchor_scales (vigeo_cloud.py:152/:338),
+    process_res (constructor arg). The kv-cache (`._kv`) is DELIBERATELY
+    EXCLUDED - F15 class per adjudication. DA3DepthEstimator carries no
+    cross-window stream state (stateless class, da3_cloud.py:119-125).
+    Formula: sha256 over sorted-key canonical JSON of the small scalar dict.
+    """
+    if est is None:
+        return None
+    info = {"class": type(est).__name__}
+    sl = getattr(est, "_scale_locked", "ABSENT")
+    info["_scale_locked"] = None if sl is None else float(sl)
+    anch = getattr(est, "_anchor_scales", None)
+    info["n_anchor_scales"] = len(anch) if isinstance(anch, (list, tuple)) else None
+    pr = getattr(est, "process_res", None)
+    info["process_res"] = int(pr) if pr is not None else None
+    return sha256_bytes(json.dumps(info, sort_keys=True).encode("utf-8"))
