+class LiveStateView(object):
+    """EPHEMERAL NON-OWNING observation window over the engine's live
+    fork-boundary state. Constructed AT THE TRUE CHUNK BOUNDARY (top of the
+    chunk-loop hunk) and handed to maybe_fork_boundary instead of the raw
+    pipeline.
+
+    OBSERVATIONAL-ONLY contract:
+      * attributes RESOLVE LIVE through _LIVE_VIEW_RESOLVERS against the
+        caller's locals / geo_state / pipeline - tensors and banks are
+        referenced, never cloned (digesting performs its own unavoidable CPU
+        byte copies at hash time);
+      * zero mutation of engine semantics; no new persistent aliases stored on
+        the pipeline; the only synthesized objects are tiny scalar dicts
+        (counters/config mirrors/digest strings);
+      * read-only: attribute assignment raises AttributeError;
+      * construction is gated to StrictCoupling-active in the patched hunk.
+    """
+
+    def __init__(self, history_latents, history_latent_counter, geo_state,
+                 pipeline, chunk_index=None, event_set_size=None,
+                 forced_off_flags=None):
+        if geo_state is None:
+            raise ValueError(
+                "[StrictFork] build_live_state_view requires the live geo_state "
+                "dict; StrictCoupling cannot certify a fork boundary without "
+                "the geometric-state fields (F03-F06).")
+        object.__setattr__(self, "_refs", {
+            "hs": history_latents,
+            "hc": history_latent_counter,
+            "gs": geo_state,
+            "pipe": pipeline,
+            "k": chunk_index,
+            "evs": event_set_size,
+            "fof": forced_off_flags,
+        })
+
+    @property
+    def refs(self):
+        """Read-only copy of the reference table (tests/audit only)."""
+        return dict(object.__getattribute__(self, "_refs"))
+
+    def __getattr__(self, name):
+        refs = object.__getattribute__(self, "_refs")
+        resolver = _LIVE_VIEW_RESOLVERS.get(name)
+        if resolver is None:
+            raise AttributeError(name)
+        return resolver(refs)
+
+    def __setattr__(self, name, value):
+        raise AttributeError("[StrictFork] LiveStateView is observational-only "
+                             "(read-only); refusing to set %r" % (name,))
+
+
+def build_live_state_view(history_latents, total_generated_latent_frames,
+                          geo_state, pipeline, chunk_index=None,
+                          event_set_size=None, forced_off_flags=None):
+    """Build the ephemeral non-owning state view handed to the fork hook.
+
+    Called from the patched __call__ hunk at the TOP of the chunk loop where
+    `history_latents` / `total_generated_latent_frames` hold exactly the values
+    left by the PREVIOUS chunk iteration (:3019-3020) - i.e. the view reflects
+    post-prefix state at the true boundary.
+    """
+    return LiveStateView(history_latents, total_generated_latent_frames,
+                         geo_state, pipeline, chunk_index=chunk_index,
+                         event_set_size=event_set_size,
+                         forced_off_flags=forced_off_flags)
+# ------------------------------------------------------------------ digest --
+def _resolve_attr(root, dotted):
+    cur = root
+    for part in dotted.split("."):
+        if isinstance(cur, dict):
+            if part not in cur:
+                return False, None
+            cur = cur[part]
+        else:
+            if not hasattr(cur, part):
+                return False, None
+            cur = getattr(cur, part)
+    return True, cur
+
+
+def _sha_of_raw(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _digest_walk(o):
+    """MUST stay byte-compatible with harness.fork_state_digest.digest_value."""
+    if o is None:
+        return "N:"
+    if isinstance(o, torch.Tensor):
+        shape_s, dtype_s = str(list(o.shape)), str(o.dtype)
+        raw, _, _ = _byte_payload(o)
+        pre = shape_s + "|" + dtype_s + "|"
+        return "T:%s:%s:%s" % (shape_s, dtype_s, _sha_of_raw(pre.encode() + raw))
+    if isinstance(o, torch.Generator):
+        st = o.get_state().contiguous().reshape(-1).numpy().tobytes()
+        return "GEN:" + _sha_of_raw(st)
+    if isinstance(o, bool):
+        return "B:" + repr(o)
+    if isinstance(o, (int, float, str)):
+        return "P:" + repr(o)
+    if isinstance(o, dict):
+        parts = ";".join("%s=%s" % (repr(k), _digest_walk(o[k]))
+                         for k in sorted(o, key=repr))
+        return "D{%s}" % parts
+    if isinstance(o, (list, tuple)):
+        return "L[%s]" % ";".join(_digest_walk(x) for x in o)
+    if isinstance(o, (set, frozenset)):
+        return "S{%s}" % ";".join(sorted(repr(x) for x in o))
+    d = getattr(o, "__dict__", None)
+    if d is not None:
+        inner = ";".join("%s=%s" % (k, _digest_walk(d[k])) for k in sorted(d))
+        return "O<%s>{%s}" % (type(o).__name__, inner)
+    return "X:" + repr(o)
+
+
+def _digest_entry(v):
+    return {"status": "OK", "kind": type(v).__name__,
+            "sha256": _sha_of_raw(_digest_walk(v).encode("utf-8"))}
+
+
+def _f13_mode_consistency(i2v, anchor):
+    """Mode legality of the v2v anchor (final delta review blocking item 1).
+
+    da3_is_i2v True  (i2v rollout) => anchor MUST be None (a legitimate
+    DIGESTED VALUE, hashed as an explicit none-representation, NOT missing).
+    da3_is_i2v False (v2v rollout) => anchor MUST be a non-None int (bools
+    excluded). Returns None when legal, else the structured reason string.
+    """
+    if i2v is True:
+        ok = anchor is None
+    elif i2v is False:
+        ok = isinstance(anchor, int) and not isinstance(anchor, bool)
+    else:
+        ok = False
+    return None if ok else "F13_MODE_INCONSISTENT"
+
+
+def _f12_main_generator_reasons(gens):
+    """F12 MAIN-GENERATOR INVARIANT (final delta review blocking item 2):
+    generators["main"] MUST exist with status OK, a non-empty sha256 and
+    nbytes > 0. Auxiliary generators hash normally but can NEVER satisfy F12.
+    Returns structured failure reasons (empty list == satisfied)."""
+    g = gens.get("main") if isinstance(gens, dict) else None
+    if g is None:
+        return ["F12_MAIN_GENERATOR_MISSING"]
+    try:
+        st = g.get_state().contiguous().reshape(-1).numpy().tobytes()
+        sha = hashlib.sha256(st).hexdigest()
+    except Exception:
+        return ["F12_MAIN_GENERATOR_INVALID"]
+    if not st or not sha:
+        return ["F12_MAIN_GENERATOR_INVALID"]
+    return []
+
+
+def _f10_evidence_reason(digest_f10_sha):
+    """F10 CAPTURE ASSERTION (final delta review blocking item 2): a capturable
+    strict digest may be written ONLY when strict CPU-RNG policy evidence
+    exists (seed + after-init sha recorded) AND the digest default-CPU hash
+    equals cpu_rng_sha256_at_fork recorded AT THIS boundary. Returns None when
+    certified, else a structured reason string."""
+    rec = _STRICT_CPU_RNG
+    if not rec or rec.get("policy") != STRICT_CPU_RNG_POLICY or \
+            rec.get("seed") is None or \
+            rec.get("cpu_rng_sha256_after_init") is None or \
+            rec.get("cpu_rng_sha256_at_fork") is None:
+        return "F10_EVIDENCE_MISSING"
+    if digest_f10_sha is None or             rec.get("cpu_rng_sha256_at_fork") != digest_f10_sha:
+        return "F10_BOUNDARY_MISMATCH"
+    return None
+
+
+def capture_fork_state_digest(pipeline_root, generators=None,
+                              fork_chunk=None, branch_id=None):
+    """FORK_STATE_DIGEST v1 manifest; mirrors harness.fork_state_digest.capture.
+
+    Preconditions enforced LOUDLY (structured RuntimeErrors, never silent
+    manifests): F13 engine-mode consistency and the F12 main-generator
+    invariant. The F10 CPU-RNG evidence assertion runs in the fork hooks
+    before any digest file is written."""
+    # F13 mode-consistency precondition: only evaluated when BOTH live values
+    # resolve; a genuinely MISSING required path still fails later through the
+    # REQUIRED-field machinery.
+    _ok_i2v, _i2v = _resolve_attr(pipeline_root, "_geo_i2v_flag_assert")
+    _ok_an, _anchor = _resolve_attr(pipeline_root,
+                                    "_geo_anchor_pix_idx_assert")
+    if _ok_i2v and _ok_an:
+        _why = _f13_mode_consistency(_i2v, _anchor)
+        if _why:
+            raise RuntimeError(
+                "[StrictFork] %s: da3_is_i2v=%r with v2v_chunk0_anchor_pix_"
+                "idx=%r violates engine-mode semantics (i2v => None REQUIRED; "
+                "v2v => non-None int REQUIRED); refusing to certify inconsist"
+                "ent mode evidence." % (_why, _i2v, _anchor))
+    # F12 main-generator invariant: fail fast BEFORE hashing/writing anything.
+    _f12_bad = _f12_main_generator_reasons(generators)
+    if _f12_bad:
+        raise RuntimeError(
+            "[StrictFork] %s: strict capture requires generators['main'] with "
+            "status OK, non-empty sha256 and nbytes>0; auxiliary generators "
+            "cannot satisfy F12 (declared generators=%r)."
+            % ("/".join(_f12_bad), sorted(generators or {})))
+    fields = {}
+    missing_required = []
+    for fid, required, paths in STATE_DIGEST_FIELD_SPEC:
+        entries = {}
+        values = []
+        for path in paths:
+            ok, v = _resolve_attr(pipeline_root, path)
+            if ok:
+                e = _digest_entry(v)
+                e["path"] = path
+                entries[path] = e
+                values.append("%s=%s" % (path, e["sha256"]))
+            else:
+                entries[path] = {"status": "MISSING", "path": path}
+        group_sha = _sha_of_raw((";".join(values)).encode("utf-8"))
+        present = all(entries[p]["status"] == "OK" for p in paths)
+        fields[fid] = {"required": required, "paths": entries,
+                       "group_sha256": group_sha, "present": present}
+        if required and not present:
+            missing_required.extend(pp for pp in paths
+                                    if entries[pp]["status"] == "MISSING")
+    gens = {}
+    for name in sorted(generators or {}):
+        g = generators[name]
+        if g is None:
+            gens[name] = {"status": "MISSING"}
+        else:
+            st = g.get_state().contiguous().reshape(-1).numpy().tobytes()
+            gens[name] = {"status": "OK", "sha256": _sha_of_raw(st),
+                          "nbytes": len(st)}
+    fields["F12"] = {"required": True, "generators": gens}
+    try:
+        gst = torch.get_rng_state().contiguous().reshape(-1).numpy().tobytes()
+        global_cpu = _sha_of_raw(gst)
+    except Exception:
+        global_cpu = None
+    fields["F10"] = {"required": True, "global_cpu_rng_sha256": global_cpu}
+    manifest = {
+        "schema": DIGEST_SCHEMA,
+        "pin": PATCH_TARGET_PIN,
+        "branch_id": branch_id if branch_id is not None else get_branch_id(),
+        "fork_chunk": fork_chunk,
+        "fields": fields,
+        "excluded_note": EXCLUDED_NOTE,
+    }
+    body = json.dumps(manifest, sort_keys=True, separators=(",", ":"))
+    manifest["manifest_sha256"] = hashlib.sha256(body.encode("utf-8")).hexdigest()
+    if missing_required:
+        manifest["missing_required_paths"] = sorted(missing_required)
+    return manifest
+
+
+def digest_canonical(manifest):
+    m = dict(manifest)
+    m.pop("manifest_sha256", None)
+    return json.dumps(m, sort_keys=True, separators=(",", ":"))
+
+
+def compare_fork_state_digest(parent, child, require_advisory=False):
+    """Mirror of harness.fork_state_digest.compare (same report contract)."""
+    if isinstance(parent, str):
+        parent = json.loads(parent)
+    if isinstance(child, str):
+        child = json.loads(child)
+    mismatches, missing, advisory = [], [], []
+    p_ok = parent.get("manifest_sha256") and \
+        hashlib.sha256(digest_canonical(parent).encode("utf-8")).hexdigest() \
+        == parent["manifest_sha256"]
+    c_ok = child.get("manifest_sha256") and \
+        hashlib.sha256(digest_canonical(child).encode("utf-8")).hexdigest() \
+        == child["manifest_sha256"]
+    if not p_ok:
+        mismatches.append({"field": "<manifest>", "reason": "PARENT_DIGEST_CORRUPT"})
+    if not c_ok:
+        mismatches.append({"field": "<manifest>", "reason": "CHILD_DIGEST_CORRUPT"})
+    pf, cf = parent.get("fields", {}), child.get("fields", {})
+    for fid in sorted(set(pf) | set(cf)):
+        pv, cv = pf.get(fid), cf.get(fid)
+        if pv is None or cv is None:
+            missing.append({"field": fid, "side": "child" if pv else "parent"})
+            continue
+        pg, cg = pv.get("group_sha256"), cv.get("group_sha256")
+        if pg is not None and cg is not None:
+            same = (pg == cg)
+        else:
+            strip = lambda d: json.dumps({k: v for k, v in sorted(d.items())
+                                          if k != "required"}, sort_keys=True)
+            same = (strip(pv) == strip(cv))
+        if not same:
+            (advisory if fid in ADVISORY_FIELDS else mismatches).append(
+                {"field": fid, "reason": "VALUE_MISMATCH"})
+        for side_name, side in (("parent_missing_path", pv),
+                                ("child_missing_path", cv)):
+            for pp, e in (side.get("paths") or {}).items():
+                if e.get("status") == "MISSING":
+                    tgt = advisory if fid in ADVISORY_FIELDS else missing
+                    tgt.append({"field": fid, side_name: pp})
+    return {
+        "match": not mismatches and not missing and
+                 (not require_advisory or not advisory),
+        "mismatches": mismatches,
+        "missing": missing,
+        "advisory_diffs": advisory,
+        "require_advisory": require_advisory,
+    }
+
+
+def _write_event(record):
+    if not ledger_enabled():
+        return
+    with _LOCK:
+        _ledger_fh()
+        _ensure_meta_line()
+        rec = dict(record)
+        rec.setdefault("seq", _next_seq())
+        rec.setdefault("run_id", run_id())
+        rec.setdefault("pair_id", pair_id())
+        _LEDGER_FH.write(json.dumps(rec, sort_keys=True) + "\n")
+        _LEDGER_FH.flush()
